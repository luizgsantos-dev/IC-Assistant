# ===========================================
# IC-UFMT Smart Agent - Configuracao
# ===========================================
# Copie este arquivo para .env e configure suas chaves
#
# O sistema detecta automaticamente qual provedor usar
# baseado nas chaves de API configuradas. A ordem de
# prioridade e: OpenAI > Anthropic > Gemini > Ollama
#
# Voce tambem pode forcar um provedor especifico usando
# a variavel LLM_PROVIDER

# -------------------------------------------
# PROVEDOR DE LLM (Opcional)
# -------------------------------------------
# Se nao definido, sera auto-detectado pelas chaves
# Opcoes: openai, anthropic, gemini, ollama
# LLM_PROVIDER=gemini

# -------------------------------------------
# OPENAI
# -------------------------------------------
# Obtenha sua chave em: https://platform.openai.com/api-keys
# Modelos: gpt-4o-mini (economico), gpt-4o (avancado), gpt-3.5-turbo
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# -------------------------------------------
# ANTHROPIC (Claude)
# -------------------------------------------
# Obtenha sua chave em: https://console.anthropic.com/
# Modelos: claude-3-5-sonnet-20241022, claude-3-opus-20240229
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# -------------------------------------------
# GOOGLE GEMINI (Recomendado - rapido e economico)
# -------------------------------------------
# Obtenha sua chave em: https://aistudio.google.com/
# Modelos: gemini-1.5-flash (rapido), gemini-1.5-pro (avancado)
GOOGLE_API_KEY=sua_chave_aqui
GEMINI_MODEL=gemini-1.5-flash

# -------------------------------------------
# OLLAMA (Local/Gratuito)
# -------------------------------------------
# Instale: https://ollama.ai/
# Depois: ollama pull llama3.2
# Modelos: llama3.2, mistral, codellama, phi3, etc.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# -------------------------------------------
# EMBEDDINGS
# -------------------------------------------
# Opcoes: openai, huggingface
# huggingface e gratuito e roda localmente (recomendado)
# Nota: primeira execucao baixa o modelo (~90MB)
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -------------------------------------------
# DIRETORIOS
# -------------------------------------------
# Pasta onde os documentos serao colocados
DATA_DIR=backend/data

# Pasta onde o banco vetorial sera armazenado
VECTORSTORE_DIR=backend/vectorstore

# -------------------------------------------
# SERVIDOR
# -------------------------------------------
HOST=0.0.0.0
PORT=8000
