# LLM Provider Configuration
# Options: openai, anthropic, ollama, gemini
LLM_PROVIDER=gemini

# OpenAI Configuration (if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-3.5-turbo

# Anthropic Configuration (if using Anthropic)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Ollama Configuration (if using Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# Google Gemini Configuration (if using Gemini - RECOMMENDED)
# Gemini 1.5 Flash offers high-speed processing with a 1M+ token context window
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Embedding Provider Configuration
# Options: openai, huggingface
EMBEDDING_PROVIDER=huggingface
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Data Directory Configuration
DATA_DIR=backend/data

# Vector Store Configuration
VECTORSTORE_DIR=backend/vectorstore

# Server Configuration
HOST=0.0.0.0
PORT=8000
